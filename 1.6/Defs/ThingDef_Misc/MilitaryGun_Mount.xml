<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ThingDef ParentName="BaseGun">
		<defName>USAC_HeavyMachineGunMounted</defName>
		<label>Foxhound GPMG</label>
		<description>A general-purpose heavy machine gun built on a lightweight composite frame, found on weapon platforms and fixed defenses everywhere. Long ago, before the war choked off the materials it needed, it was a highly successful replacement for the M2 heavy machine gun.</description>
		<graphicData>
			<texPath>Things/Building/Turrets/USAC_Gun_Foxhound</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>2.5</drawSize>
		</graphicData>
		<relicChance>0</relicChance>
		<tradeability>None</tradeability>
		<destroyOnDrop>true</destroyOnDrop>
		<statBases>
			<MaxHitPoints>150</MaxHitPoints>
			<AccuracyTouch>0.50</AccuracyTouch>
			<AccuracyShort>0.58</AccuracyShort>
			<AccuracyMedium>0.45</AccuracyMedium>
			<AccuracyLong>0.36</AccuracyLong>
			<RangedWeapon_Cooldown>2.3</RangedWeapon_Cooldown>
		</statBases>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>USAC_Bullet_HeavyMachineGun</defaultProjectile>
				<requireLineOfSight>true</requireLineOfSight>
				<warmupTime>1.5</warmupTime>
				<range>39.9</range>
				<ticksBetweenBurstShots>20</ticksBetweenBurstShots>
				<burstShotCount>5</burstShotCount>
				<soundCast>Shot_Autocannon</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>10</muzzleFlashScale>
				<consumeFuelPerShot>1</consumeFuelPerShot>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
			</li>
		</verbs>
		<weaponTags>
			<li>USAC_Cobalt_GPMG</li>
		</weaponTags>
		<modExtensions>
			<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="IssacZhuang.MuzzleFlash">
				<def>MF_StandardMuzzleFalsh</def>
				<drawSize>(0.5,0.5)</drawSize>
				<offsets>
					<li>(0.75,0)</li>
				</offsets>
				<isAlternately>true</isAlternately>
			</li>
		</modExtensions>
	</ThingDef>

</Defs>