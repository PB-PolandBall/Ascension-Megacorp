<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!-- USAC 企业文化 -->
    <CultureDef MayRequire="ludeon.rimworld.ideology">
        <defName>USAC_Culture</defName>
        <label>Zenith Ascension</label>
        <description>Zenith Ascension is a military-industrial complex under the United Stellar Armament Company, whose core business is coordinating military development projects across various technical departments and selling arms abroad.

Its financial statements are impressive, and beneath them lies a vast network of bribery and cronyism - none of which has ever slowed it down. It still eliminates competitors outright, absorbs their assets, and runs privateering fleets to corner the arms market on the back of money-for-power deals.</description>
        <ideoNameMaker MayRequire="ludeon.rimworld.ideology">NamerIdeo_USAC</ideoNameMaker>
        <deityNameMaker MayRequire="ludeon.rimworld.ideology">NamerDeity_USAC</deityNameMaker>
        <deityTypeMaker MayRequire="ludeon.rimworld.ideology">DeityTypeMaker_USAC</deityTypeMaker>
        <leaderTitleMaker MayRequire="ludeon.rimworld.ideology">LeaderTitleMaker_USAC</leaderTitleMaker>
        <festivalNameMaker MayRequire="ludeon.rimworld.ideology">NamerFestival_USAC</festivalNameMaker>
        <preferredWeaponClasses>
            <noble>Ultratech</noble>
            <despised>Neolithic</despised>
        </preferredWeaponClasses>
        <allowedPlaceTags>
            <li>OriginSpacer</li>
        </allowedPlaceTags>
        <iconPath>World/WorldObjects/Expanding/USAC_Icon</iconPath>
        <thingStyleCategories>
            <li>
                <category>USAC_Segments</category>
                <priority>2</priority>
            </li>
            <li MayRequire="aoba.deadmanswitch.core">
                <category>DMS_Industrial</category>
                <priority>1</priority>
            </li>
        </thingStyleCategories>
        <styleItemTags>
            <li>
                <tag>Urban</tag>
                <baseWeight>10</baseWeight>
                <weightFactor>10</weightFactor>
            </li>
            <li>
                <tag>NoBeard</tag>
                <baseWeight>10</baseWeight>
                <weightFactor>1</weightFactor>
            </li>
            <li>
                <tag>BeardUrban</tag>
                <baseWeight>0.2</baseWeight>
                <weightFactor>1</weightFactor>
            </li>
            <li>
                <tag>NoTattoo</tag>
                <baseWeight>1</baseWeight>
                <weightFactor>1</weightFactor>
            </li>
        </styleItemTags>
    </CultureDef>
</Defs>